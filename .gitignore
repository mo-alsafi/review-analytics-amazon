# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local configurations
.env
*.log

# Raw and intermediate data
# Raw data: exclude large datasets, retain provenance
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/manifest.json

# Interim data: exclude Parquet, retain conversion report
/data/interim/*
!/data/interim/.gitkeep
!/data/interim/conversion_report.json

# Processed data
/data/processed/*
!/data/processed/.gitkeep

# Models and artifacts
/models/
*.joblib
*.pkl

# OS files
.DS_Store
Thumbs.db